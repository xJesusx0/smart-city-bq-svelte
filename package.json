{
	"name": "smart-city-bq",
	"private": true,
	"version": "0.0.1",
	"type": "module",
	"scripts": {
		"generate:api": "openapi-typescript http://127.0.0.1:8000/openapi.json -o src/lib/__gen__/api_v1.d.ts",
		"generate:api-local": "openapi-typescript http://127.0.0.1:8000/openapi.json -o src/lib/__gen__/api_v1.d.ts",
		"dev": "vite dev",
		"build": "vite build",
		"preview": "vite preview",
		"prepare": "svelte-kit sync || echo ''",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"format": "prettier --write .",
		"lint": "prettier --check . && eslint ."
	},
	"devDependencies": {
		"@eslint/compat": "^1.4.0",
		"@eslint/js": "^9.36.0",
		"@sveltejs/adapter-auto": "^6.1.1",
		"@sveltejs/kit": "^2.43.7",
		"@sveltejs/vite-plugin-svelte": "^6.2.1",
		"@tailwindcss/typography": "^0.5.19",
		"@tailwindcss/vite": "^4.1.14",
		"@types/node": "^22.18.8",
		"eslint": "^9.36.0",
		"eslint-config-prettier": "^10.1.8",
		"eslint-plugin-svelte": "^3.12.4",
		"globals": "^16.4.0",
		"openapi-typescript": "^7.9.1",
		"prettier": "^3.6.2",
		"prettier-plugin-svelte": "^3.4.0",
		"prettier-plugin-tailwindcss": "^0.6.14",
		"svelte": "^5.39.8",
		"svelte-check": "^4.3.2",
		"tailwindcss": "^4.1.14",
		"typescript": "^5.9.3",
		"typescript-eslint": "^8.45.0",
		"vite": "^7.1.8"
	},
	"dependencies": {
		"@internationalized/date": "^3.8.1",
		"@lucide/svelte": "^0.544.0",
		"@tanstack/svelte-query": "^5.90.2",
		"bits-ui": "^2.11.5",
		"clsx": "^2.1.1",
		"openapi-fetch": "^0.14.1",
		"tailwind-merge": "^3.3.1",
		"tailwind-variants": "^3.1.1",
		"tw-animate-css": "^1.4.0"
	}
}
